<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:stcpui.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="stcpui.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        xmlns:local="clr-namespace:stcpui.Views"
        Icon="/Assets/avalonia-logo.ico"
        Title="STcp 运维">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>
    
    <DockPanel>
        <!-- <Menu DockPanel.Dock="Top"> -->
        <!--     <MenuItem Header="STcp"> -->
        <!--         <MenuItem Header="设置"/> -->
        <!--     </MenuItem> -->
        <!-- </Menu> -->
        <TabbedPage TabPlacement="Bottom">
            <ContentPage Header="TcpClient">
                <local:TcpClient></local:TcpClient>
            </ContentPage>
            <ContentPage Header="TcpServer">
                <local:TcpServer></local:TcpServer>
            </ContentPage>
            <ContentPage Header="Pm2管理">
                <local:Pm2></local:Pm2>
            </ContentPage>
            <ContentPage Header="ModbusClient">
                <local:ModbusClient></local:ModbusClient>
            </ContentPage>
            <ContentPage Header="Win工具">
                <local:WinTools></local:WinTools>
            </ContentPage>
            <ContentPage Header="关于">
                <StackPanel>
                    <TextBlock TextAlignment="Center" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center">
                        版本：26.9.7
                    </TextBlock>
                </StackPanel>
            </ContentPage>
        </TabbedPage>
    </DockPanel>
    
</Window>
